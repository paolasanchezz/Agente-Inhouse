# Credenciais — NUNCA commitar (cada colaborador cria o seu)
meta-ads/.env
dashboard/.env
dashboard/data.json

# Dashboard CM gerada (PII de leads + valores de contratos — regenerar via gerar_relatorio.py)
dashboard/relatorio-*.html
dashboard/relatorio-*.html.bak

# Dashboard CM dinâmica-estática (Vercel) — dados com PII de leads + valores comerciais.
# Regeneráveis via dashboard-buzz-br-vercel/exportar_dados.py. O CÓDIGO (index.html, motor.js,
# *.py, *.mjs, PLANO) versiona normalmente; só os dados gerados NÃO.
dashboard-buzz-br-vercel/dados-2026.json
dashboard-buzz-br-vercel/paridade_esperado.json

# Auditoria de deals CM (PII: emails + ids de deals). Outputs regeneraveis via /auditar-deals-cm.
# Preserva a pasta via .gitkeep; ignora os relatorios/CSVs.
dashboard/auditoria/*
!dashboard/auditoria/.gitkeep

# Chunks base64 temporarios de processamento de CSV no dashboard. Lixo regeneravel.
dashboard/.csv-b64*.tmp

# Pasta de scratch efemera: logs, snapshots HTML, probes, downloads, dados temporarios
# (inclui inscricoes de webinar = PII). Regeneravel/descartavel — nunca versionar.
tmp/

# meta-ads-legacy/ — arquivos do pipeline antigo (substituido por /bunzzai em 2026-06-22).
# Bancos, caches e relatorios continuam gitignored caso o pipeline seja reativado.
meta-ads-legacy/meta_ads.db
meta-ads-legacy/cache/*
!meta-ads-legacy/cache/.gitkeep
meta-ads-legacy/reports/*.md
meta-ads-legacy/reports/*.txt
!meta-ads-legacy/reports/.gitkeep
meta-ads-legacy/url_search_results.json
meta-ads-legacy/credentials-snapshot.md

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Git worktrees (checkouts temporarios de outras branches)
.claude/worktrees/

# Permissoes pessoais do Claude Code (cada colaborador tem as suas)
.claude/settings.local.json

# Config local per-colaborador do agente (cross-skill: LP_SIBLING_BASE etc.)
.env.local

# Runtime lockfile do MCP de tarefas agendadas
.claude/scheduled_tasks.lock

# Relatorios locais de /pull-request-review (JSON da API, patches e .md). Artefatos pessoais, nao versionar.
reviews/

# Junction temporario para preview local de LPs (resolve `../../brand/...` no http.server
# sem precisar reescrever paths; o pipeline `/lp-publicar` faz o rewrite real no deploy).
# Criado por: cmd /c mklink /J landing-pages/brand brand
landing-pages/brand

# Criativos estaticos gerados (PNGs + copias de assets de marca). Pesados e regeneraveis
# via render.py — upload manual pro Drive/Slack (ver memoria feedback-criativos-pasta-local).
# Ignora o CONTEUDO (criativos/*), nao a pasta — senao a excecao do GUIDELINES nao funciona
# (git nao re-inclui arquivo cujo diretorio-pai esta excluido).
criativos/*
# Excecao: o GUIDELINES universal de criativos e versionado (igual landing-pages/GUIDELINES.md).
!criativos/GUIDELINES.md
