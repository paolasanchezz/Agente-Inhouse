# Credenciais — NUNCA commitar (cada colaborador cria o seu)
meta-ads/.env
meta-ads/credentials-snapshot.md
dashboard/.env
dashboard/data.json

# Dashboard CM gerada (PII de leads + valores de contratos — regenerar via gerar_relatorio.py)
dashboard/relatorio-*.html
dashboard/relatorio-*.html.bak

# Banco de dados local (cada colaborador popula rodando o fetch)
meta-ads/data/meta_ads.db

# Cache de estrutura bruta da API (preserva pasta via .gitkeep)
meta-ads/data/cache/*
!meta-ads/data/cache/.gitkeep

# Relatorios gerados (regeneraveis via /meta-ads-report)
meta-ads/data/reports/*.md
meta-ads/data/reports/*.txt
!meta-ads/data/reports/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Git worktrees (checkouts temporarios de outras branches)
.claude/worktrees/

# Permissoes pessoais do Claude Code (cada colaborador tem as suas)
.claude/settings.local.json

# Config local per-colaborador do agente (cross-skill: LP_SIBLING_BASE etc.)
.env.local

# Runtime lockfile do MCP de tarefas agendadas
.claude/scheduled_tasks.lock

# Relatorios locais de /pull-request-review (JSON da API, patches e .md). Artefatos pessoais, nao versionar.
reviews/
