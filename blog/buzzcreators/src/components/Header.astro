---
import { NAV_LINKS, ORG_LOGO } from '../consts';
import { conversionUrl, utmContentFromPath } from '../lib/utm';
const path = Astro.url.pathname;
// CTA de conversão: utm_source=blog + utm_content = artigo/página atual (lib/utm.ts)
const ctaUrl = conversionUrl('/marcas', utmContentFromPath(path), 'marcas');
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Blog Buzzcreators, página inicial">
      <img src={ORG_LOGO} alt="Buzzcreators" width="354" height="50" class="brand-logo" />
      <span class="brand-tag overline">Blog</span>
    </a>

    <nav aria-label="Navegação principal" class="nav">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="nav-link"
            aria-current={path === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="btn btn-primary nav-cta" href={ctaUrl} target="_blank" rel="noopener">
        Conhecer a plataforma
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--c-gray-100);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    flex: 0 1 auto;
    min-width: 0; /* deixa o flex encolher a logo em tela estreita */
  }
  .brand-logo {
    /* max-height (nao height fixa): quando o mobile espreme a largura via
       max-width global, a altura acompanha e a logo nao deforma.
       flex-shrink + min-width 0: a IMAGEM encolhe (mantendo proporcao via
       height auto) em vez de vazar por baixo do CTA em tela estreita. */
    flex: 0 1 auto;
    min-width: 0;
    width: auto;
    height: auto;
    max-height: 30px;
  }
  .brand-tag {
    color: var(--c-orange-dark);
    padding-top: 2px;
    flex-shrink: 0; /* o "Blog" nao esmaga; quem encolhe e a logo */
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-shrink: 0; /* o CTA nunca invade a area da logo */
  }
  .nav-link {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--c-ink-soft);
    text-decoration: none;
    font-size: 1rem;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--c-purple-dark);
  }
  .nav-cta {
    padding: 11px 20px;
    font-size: 0.95rem;
    white-space: nowrap; /* botao de 2 linhas quebrava a altura do header */
  }
  @media (max-width: 640px) {
    .header-inner {
      gap: var(--space-md);
    }
    .nav-link {
      display: none;
    }
    .nav {
      gap: var(--space-md);
    }
    .nav-cta {
      padding: 10px 14px;
      font-size: 0.85rem;
    }
  }
  /* Tela bem estreita: some a tag "Blog" pra logo respirar ao lado do CTA */
  @media (max-width: 520px) {
    .brand-tag {
      display: none;
    }
  }
  /* Telas mínimas (320-400px): CTA mais compacto pra logo não virar migalha */
  @media (max-width: 400px) {
    .nav-cta {
      padding: 9px 12px;
      font-size: 0.8rem;
    }
  }
</style>
