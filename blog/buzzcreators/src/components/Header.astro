---
import { NAV_LINKS, BRAND_HOME, ORG_LOGO } from '../consts';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Blog Buzzcreators, página inicial">
      <img src={ORG_LOGO} alt="Buzzcreators" width="354" height="50" class="brand-logo" />
      <span class="brand-tag overline">Blog</span>
    </a>

    <nav aria-label="Navegação principal" class="nav">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="nav-link"
            aria-current={path === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="btn btn-primary nav-cta" href={BRAND_HOME} target="_blank" rel="noopener">
        Conhecer a plataforma
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--c-gray-100);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
  }
  .brand-logo {
    height: 30px;
    width: auto;
  }
  .brand-tag {
    color: var(--c-orange-dark);
    padding-top: 2px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }
  .nav-link {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--c-ink-soft);
    text-decoration: none;
    font-size: 1rem;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--c-purple-dark);
  }
  .nav-cta {
    padding: 11px 20px;
    font-size: 0.95rem;
  }
  @media (max-width: 640px) {
    .nav-link {
      display: none;
    }
    .nav-cta {
      padding: 10px 16px;
      font-size: 0.85rem;
    }
  }
</style>
