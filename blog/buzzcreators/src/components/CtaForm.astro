---
/*
 * CtaForm — FORMULÁRIO ÚNICO do blog.
 * É renderizado UMA vez no BaseLayout → aparece idêntico em TODAS as páginas.
 * Para mudar texto/campos ou trocar o CRM, edite SÓ este arquivo.
 *
 * >>> INTEGRADO AO MAILCHIMP (2026-07-08) <<<
 * POST nativo pro endpoint do embed oficial (audiência us14 do grupo), com os
 * mesmos campos: FNAME, LNAME, EMAIL, grupo de interesse 46266, tag 10371138 e
 * o honeypot anti-bot. NÃO carregamos o mc-validate.js do embed (jQuery externo
 * bloqueado pela CSP estrita; a validação nativa do HTML5 cobre o required/email).
 * A confirmação abre na página hospedada do Mailchimp (target _blank).
 *
 * CSP: o endpoint está liberado APENAS em form-action no vercel.json.
 * Se trocar de audiência/CRM, atualize lá também.
 */
interface Props {
  heading?: string;
  subheading?: string;
}
const {
  heading = 'Receba ideias de influência que viram resultado',
  subheading = 'Conteúdo prático sobre creator economy e ROI de campanhas, direto no seu e-mail. Sem spam.',
} = Astro.props;

const MC_ACTION =
  'https://buzzmonitor.us14.list-manage.com/subscribe/post?u=3606af452c914bd248903164a&id=a42eafb76c&f_id=00d5bae5f0';
const MC_HONEYPOT = 'b_3606af452c914bd248903164a_a42eafb76c';
const MC_TAG = '10371138';
---

<section class="cta-band" aria-labelledby="cta-heading">
  <div class="container cta-inner">
    <div class="cta-copy">
      <p class="overline">Newsletter Buzzcreators</p>
      <h2 id="cta-heading">{heading}</h2>
      <p class="cta-sub">{subheading}</p>
    </div>

    <form
      id="cta-form"
      class="cta-form"
      action={MC_ACTION}
      method="post"
      target="_blank"
      data-crm="mailchimp"
    >
      <div class="cta-field">
        <label class="visually-hidden" for="cta-fname">Nome</label>
        <input
          id="cta-fname"
          name="FNAME"
          type="text"
          placeholder="Nome"
          autocomplete="given-name"
        />
      </div>
      <div class="cta-field">
        <label class="visually-hidden" for="cta-lname">Sobrenome</label>
        <input
          id="cta-lname"
          name="LNAME"
          type="text"
          placeholder="Sobrenome"
          autocomplete="family-name"
        />
      </div>
      <label class="visually-hidden" for="cta-email">Seu melhor e-mail</label>
      <input
        id="cta-email"
        class="cta-email"
        name="EMAIL"
        type="email"
        required
        placeholder="seu@email.com"
        autocomplete="email"
      />
      <label class="cta-consent">
        <input type="checkbox" name="group[46266][1]" value="1" checked />
        <span>Quero receber as novidades de Social Media e CRM e comunicados da Buzzmonitor</span>
      </label>
      <input type="hidden" name="tags" value={MC_TAG} />
      <!-- Honeypot anti-bot do Mailchimp: fica fora da tela e deve seguir vazio -->
      <div class="cta-hp" aria-hidden="true">
        <input type="text" name={MC_HONEYPOT} tabindex="-1" autocomplete="off" value="" />
      </div>
      <button type="submit" class="btn btn-primary">Quero receber</button>
      <p class="cta-micro">Você pode cancelar quando quiser.</p>
    </form>
  </div>
</section>

<style>
  .cta-band {
    background: var(--c-gray-50);
    border-top: 1px solid var(--c-gray-100);
    padding-block: var(--section-y);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }
  .cta-copy h2 {
    margin-top: var(--space-sm);
    max-width: 16ch;
  }
  .cta-sub {
    margin-top: var(--space-md);
    color: var(--c-ink-soft);
    max-width: 46ch;
  }
  .cta-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    align-items: center;
  }
  .cta-form input[type='text'],
  .cta-form input[type='email'] {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 16px 18px;
    border: 2px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-white);
  }
  .cta-form input:focus-visible {
    border-color: var(--c-purple);
    outline-offset: 0;
  }
  .cta-email {
    grid-column: 1 / -1;
  }
  .cta-consent {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: 0.9rem;
    color: var(--c-ink-soft);
    cursor: pointer;
  }
  .cta-consent input {
    margin-top: 4px;
    accent-color: var(--c-purple);
    flex-shrink: 0;
  }
  /* Honeypot: fora da tela (padrão do embed Mailchimp), invisível pra gente */
  .cta-hp {
    position: absolute;
    left: -5000px;
  }
  .cta-form .btn {
    grid-column: 1 / -1;
    justify-content: center;
  }
  .cta-micro {
    grid-column: 1 / -1;
    font-size: 0.82rem;
    color: var(--c-ink-soft);
    margin-top: 2px;
  }
  @media (max-width: 760px) {
    .cta-inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
  @media (max-width: 480px) {
    .cta-form {
      grid-template-columns: 1fr; /* Nome e Sobrenome empilham em tela estreita */
    }
    .cta-field {
      grid-column: 1 / -1;
    }
  }
</style>

