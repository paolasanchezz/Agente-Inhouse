{
  "mcpServers": {
    "supabase": {
      "command": "uvx",
      "args": ["--python", "3.12", "postgres-mcp", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "${SUPABASE_PG_URL}"
      }
    },
    "mcp-brasil": {
      "command": "uvx",
      "args": ["--python", "3.12", "--from", "mcp-brasil", "python", "-m", "mcp_brasil.server"]
    }
  }
}
