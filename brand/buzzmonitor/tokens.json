{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "brand": "buzzmonitor",
    "version": "1.0.0",
    "lastUpdated": "2026-04-16",
    "figmaFileKey": ""
  },
  "colors": {
    "primary": {
      "$type": "color",
      "$value": "#390155",
      "$description": "Roxo escuro — cor principal da marca, fundos escuros, destaques"
    },
    "primaryLight": {
      "$type": "color",
      "$value": "#F2D8FF",
      "$description": "Lilás claro — variante suave do roxo, fundos e hovers"
    },
    "secondary": {
      "$type": "color",
      "$value": "#EB7C2E",
      "$description": "Laranja vibrante — CTAs, acentos, elementos de destaque"
    },
    "secondaryLight": {
      "$type": "color",
      "$value": "#FFD5C3",
      "$description": "Pêssego claro — variante suave do laranja"
    },
    "teal": {
      "$type": "color",
      "$value": "#0E9D9B",
      "$description": "Verde-azulado — elementos complementares, ícones, badges"
    },
    "tealLight": {
      "$type": "color",
      "$value": "#CDFDFC",
      "$description": "Ciano claro — variante suave do teal"
    },
    "yellow": {
      "$type": "color",
      "$value": "#FCBD4F",
      "$description": "Amarelo dourado — alertas positivos, destaques secundários"
    },
    "yellowLight": {
      "$type": "color",
      "$value": "#FFE1AD",
      "$description": "Amarelo claro — variante suave"
    },
    "pink": {
      "$type": "color",
      "$value": "#DE2451",
      "$description": "Rosa/magenta vibrante — alertas, CTAs alternativos"
    },
    "pinkLight": {
      "$type": "color",
      "$value": "#FFD7E0",
      "$description": "Rosa claro — variante suave"
    },
    "neutral": {
      "900": { "$type": "color", "$value": "#1a1a1a", "$description": "Texto principal" },
      "700": { "$type": "color", "$value": "#4a4a4a", "$description": "Texto secundario" },
      "300": { "$type": "color", "$value": "#d1d1d1", "$description": "Bordas, divisores" },
      "100": { "$type": "color", "$value": "#f5f5f5", "$description": "Fundo claro" },
      "0":   { "$type": "color", "$value": "#ffffff", "$description": "Fundo branco" }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#0E9D9B", "$description": "Usa teal da marca" },
      "warning": { "$type": "color", "$value": "#FCBD4F", "$description": "Usa amarelo da marca" },
      "error":   { "$type": "color", "$value": "#DE2451", "$description": "Usa rosa da marca" },
      "info":    { "$type": "color", "$value": "#390155", "$description": "Usa roxo da marca" }
    },
    "gradients": {
      "1": { "$type": "gradient", "$value": "linear-gradient(135deg, #390155, #EB7C2E)", "$description": "Roxo para laranja" },
      "2": { "$type": "gradient", "$value": "linear-gradient(135deg, #FCBD4F, #0E9D9B)", "$description": "Amarelo para teal — fundo vibrante" },
      "3": { "$type": "gradient", "$value": "linear-gradient(135deg, #DE2451, #EB7C2E)", "$description": "Rosa para laranja — CTAs quentes" },
      "4": { "$type": "gradient", "$value": "linear-gradient(135deg, #0E9D9B, #390155)", "$description": "Teal para roxo — fundo frio" }
    }
  },
  "typography": {
    "fontFamily": {
      "heading":  { "$type": "fontFamily", "$value": "League Spartan", "$description": "Titulos — bold, impactante" },
      "subtitle": { "$type": "fontFamily", "$value": "HK Grotesk", "$description": "Subtitulos — light, limpo" },
      "body":     { "$type": "fontFamily", "$value": "Lato", "$description": "Texto corrido — legivel, neutro" },
      "mono":     { "$type": "fontFamily", "$value": "monospace", "$description": "Fonte monoespacada (fallback)" }
    },
    "fontSize": {
      "xs":   { "$type": "dimension", "$value": "12px" },
      "sm":   { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg":   { "$type": "dimension", "$value": "18px" },
      "xl":   { "$type": "dimension", "$value": "20px" },
      "2xl":  { "$type": "dimension", "$value": "24px" },
      "3xl":  { "$type": "dimension", "$value": "30px" },
      "4xl":  { "$type": "dimension", "$value": "36px" },
      "5xl":  { "$type": "dimension", "$value": "48px" }
    },
    "fontWeight": {
      "light":    { "$type": "fontWeight", "$value": 300, "$description": "HK Grotesk Light para subtitulos" },
      "regular":  { "$type": "fontWeight", "$value": 400, "$description": "Lato regular para corpo" },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700, "$description": "League Spartan bold para titulos" },
      "black":    { "$type": "fontWeight", "$value": 900, "$description": "League Spartan black para impacto" }
    },
    "lineHeight": {
      "tight":   { "$type": "dimension", "$value": "1.1" },
      "normal":  { "$type": "dimension", "$value": "1.5" },
      "relaxed": { "$type": "dimension", "$value": "1.75" }
    }
  },
  "spacing": {
    "xs":  { "$type": "dimension", "$value": "4px" },
    "sm":  { "$type": "dimension", "$value": "8px" },
    "md":  { "$type": "dimension", "$value": "16px" },
    "lg":  { "$type": "dimension", "$value": "24px" },
    "xl":  { "$type": "dimension", "$value": "32px" },
    "2xl": { "$type": "dimension", "$value": "48px" },
    "3xl": { "$type": "dimension", "$value": "64px" }
  },
  "borderRadius": {
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "8px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(0,0,0,0.05)" },
    "md": { "$type": "shadow", "$value": "0 4px 6px rgba(0,0,0,0.07)" },
    "lg": { "$type": "shadow", "$value": "0 10px 15px rgba(0,0,0,0.1)" }
  }
}
