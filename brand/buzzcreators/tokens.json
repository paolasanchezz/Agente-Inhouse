{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "brand": "buzzcreators",
    "version": "1.0.0",
    "lastUpdated": "2026-04-27",
    "source": "Brandbook oficial Buzzcreators (ID Visual p IA.pdf)",
    "figmaFileKey": ""
  },
  "colors": {
    "primary": {
      "$type": "color",
      "$value": "#3a1652",
      "$description": "Roxo escuro — cor principal da marca, usada no wordmark 'BUZZ' e em titulos. Transmite seriedade e autoridade."
    },
    "primaryLight": {
      "$type": "color",
      "$value": "#6a3895",
      "$description": "Roxo medio — cor secundaria do wordmark 'CREATORS' (parte inicial) e elementos de apoio. Cria o gradiente roxo → laranja."
    },
    "secondary": {
      "$type": "color",
      "$value": "#ff8119",
      "$description": "Laranja claro — cor de destaque/CTA, parte final do gradiente do wordmark."
    },
    "secondaryDark": {
      "$type": "color",
      "$value": "#ff7300",
      "$description": "Laranja escuro — variante para hovers, estados ativos e acentos mais firmes."
    },
    "neutral": {
      "900": { "$type": "color", "$value": "#1a1a1a", "$description": "Texto principal" },
      "700": { "$type": "color", "$value": "#4a4a4a", "$description": "Texto secundario" },
      "300": { "$type": "color", "$value": "#d1d1d1", "$description": "Bordas, divisores" },
      "200": { "$type": "color", "$value": "#eaeef1", "$description": "Cinza claro 1 — fundos de secao, cards" },
      "100": { "$type": "color", "$value": "#f7f9fb", "$description": "Cinza claro 2 — fundo principal alternativo (off-white)" },
      "0":   { "$type": "color", "$value": "#ffffff", "$description": "Fundo branco puro" }
    },
    "gradient": {
      "brand": {
        "$type": "gradient",
        "$value": "linear-gradient(90deg, #3a1652 0%, #6a3895 35%, #ff8119 75%, #ff7300 100%)",
        "$description": "Gradiente assinatura da marca (roxo → laranja). Usado em titulos hero, divisores e elementos de destaque."
      },
      "brandSubtle": {
        "$type": "gradient",
        "$value": "linear-gradient(135deg, #f7f9fb 0%, #eaeef1 100%)",
        "$description": "Gradiente neutro suave para fundos de secao."
      }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#22c55e" },
      "warning": { "$type": "color", "$value": "#f59e0b" },
      "error":   { "$type": "color", "$value": "#ef4444" },
      "info":    { "$type": "color", "$value": "#6a3895", "$description": "Reusa o roxo medio da marca para mensagens informativas" }
    }
  },
  "typography": {
    "fontFamily": {
      "heading": {
        "$type": "fontFamily",
        "$value": "DM Sans",
        "$description": "Fonte de titulos — peso Bold conforme brandbook oficial. Geometrica, moderna, alta legibilidade."
      },
      "subheading": {
        "$type": "fontFamily",
        "$value": "HK Grotesk",
        "$description": "Fonte de subtitulos — peso Light conforme brandbook oficial. Quando indisponivel, fallback para DM Sans Light."
      },
      "body": {
        "$type": "fontFamily",
        "$value": "DM Sans",
        "$description": "Fonte de corpo — peso Regular. Mesma familia dos titulos para coerencia."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "monospace",
        "$description": "Fonte monoespacada para codigo"
      }
    },
    "fontFamilyStack": {
      "heading": { "$type": "string", "$value": "'DM Sans', system-ui, -apple-system, sans-serif" },
      "subheading": { "$type": "string", "$value": "'HK Grotesk', 'DM Sans', system-ui, -apple-system, sans-serif" },
      "body": { "$type": "string", "$value": "'DM Sans', system-ui, -apple-system, sans-serif" }
    },
    "fontSize": {
      "xs":   { "$type": "dimension", "$value": "12px" },
      "sm":   { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg":   { "$type": "dimension", "$value": "18px" },
      "xl":   { "$type": "dimension", "$value": "20px" },
      "2xl":  { "$type": "dimension", "$value": "24px" },
      "3xl":  { "$type": "dimension", "$value": "30px" },
      "4xl":  { "$type": "dimension", "$value": "36px" },
      "5xl":  { "$type": "dimension", "$value": "48px" },
      "6xl":  { "$type": "dimension", "$value": "60px" }
    },
    "fontWeight": {
      "light":    { "$type": "fontWeight", "$value": 300, "$description": "HK Grotesk Light — subtitulos" },
      "regular":  { "$type": "fontWeight", "$value": 400, "$description": "DM Sans Regular — corpo" },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700, "$description": "DM Sans Bold — titulos" }
    },
    "letterSpacing": {
      "subheading": { "$type": "dimension", "$value": "0.15em", "$description": "Subtitulos em UPPERCASE com tracking generoso (estilo do logo 'MEDIA & INFLUENCER MARKETING')" },
      "tight":      { "$type": "dimension", "$value": "-0.02em" },
      "normal":     { "$type": "dimension", "$value": "0" }
    },
    "lineHeight": {
      "tight":   { "$type": "dimension", "$value": "1.15" },
      "snug":    { "$type": "dimension", "$value": "1.25" },
      "normal":  { "$type": "dimension", "$value": "1.5" },
      "relaxed": { "$type": "dimension", "$value": "1.75" }
    }
  },
  "spacing": {
    "xs":  { "$type": "dimension", "$value": "4px" },
    "sm":  { "$type": "dimension", "$value": "8px" },
    "md":  { "$type": "dimension", "$value": "16px" },
    "lg":  { "$type": "dimension", "$value": "24px" },
    "xl":  { "$type": "dimension", "$value": "32px" },
    "2xl": { "$type": "dimension", "$value": "48px" },
    "3xl": { "$type": "dimension", "$value": "64px" },
    "4xl": { "$type": "dimension", "$value": "96px" }
  },
  "borderRadius": {
    "sm":   { "$type": "dimension", "$value": "8px", "$description": "Radius pequeno (botoes secundarios)" },
    "md":   { "$type": "dimension", "$value": "16px", "$description": "Radius medio (cards, inputs)" },
    "lg":   { "$type": "dimension", "$value": "24px", "$description": "Radius dos cards de cor do brandbook (squircle generoso)" },
    "xl":   { "$type": "dimension", "$value": "32px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(58,22,82,0.06)" },
    "md": { "$type": "shadow", "$value": "0 4px 12px rgba(58,22,82,0.08)" },
    "lg": { "$type": "shadow", "$value": "0 10px 30px rgba(58,22,82,0.12)" }
  }
}
