{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "brand": "cxpress",
    "version": "1.0.0",
    "lastUpdated": "2026-04-21",
    "figmaFileKey": "arGIts9tqKJUzkPTk4I80s",
    "source": "Cxpress Brandbook for media, Abril 2024"
  },
  "colors": {
    "primary": {
      "$type": "color",
      "$value": "#4A69BD",
      "$description": "Azul royal — cor principal da marca, CTAs preenchidos, fundos de destaque (capa, footer)"
    },
    "primaryDark": {
      "$type": "color",
      "$value": "#232960",
      "$description": "Azul marinho profundo — texto principal, titulos, logo sobre fundo claro"
    },
    "primaryLight": {
      "$type": "color",
      "$value": "#C1C7FF",
      "$description": "Lilas claro — auxiliar de primaryDark, backgrounds sutis"
    },
    "primaryLighter": {
      "$type": "color",
      "$value": "#D7E2FF",
      "$description": "Azul muito claro — auxiliar de primary (royal), backgrounds"
    },
    "accent": {
      "$type": "color",
      "$value": "#EF863C",
      "$description": "Laranja — acentos, destaques decorativos, CTAs alternativos"
    },
    "accentLight": {
      "$type": "color",
      "$value": "#FFDCC3",
      "$description": "Pessego — auxiliar do laranja, backgrounds suaves"
    },
    "warning": {
      "$type": "color",
      "$value": "#F1A908",
      "$description": "Amarelo dourado — destaques secundarios, pilares decorativos, elementos positivos"
    },
    "warningLight": {
      "$type": "color",
      "$value": "#FFF3DA",
      "$description": "Creme — auxiliar do amarelo, backgrounds claros"
    },
    "neutral": {
      "900": { "$type": "color", "$value": "#1a1a1a", "$description": "Texto principal em fundos claros quando nao se usa primaryDark" },
      "700": { "$type": "color", "$value": "#4a4a4a", "$description": "Texto secundario" },
      "300": { "$type": "color", "$value": "#d1d1d1", "$description": "Bordas, divisores" },
      "100": { "$type": "color", "$value": "#f5f5f5", "$description": "Fundo claro alternativo" },
      "0":   { "$type": "color", "$value": "#ffffff", "$description": "Fundo branco" }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#22c55e", "$description": "Verde generico (fora da paleta de marca — usar com moderacao)" },
      "warning": { "$type": "color", "$value": "#F1A908", "$description": "Usa o amarelo da marca" },
      "error":   { "$type": "color", "$value": "#ef4444", "$description": "Vermelho generico (fora da paleta — usar com moderacao)" },
      "info":    { "$type": "color", "$value": "#4A69BD", "$description": "Usa o azul royal da marca" }
    }
  },
  "typography": {
    "fontFamily": {
      "heading": { "$type": "fontFamily", "$value": "Open Sans", "$description": "Titulos — bold 700, impacto" },
      "body":    { "$type": "fontFamily", "$value": "Source Sans 3", "$description": "Corpo de texto — Source Sans 3 (sucessor do Source Sans Pro)" },
      "accent":  { "$type": "fontFamily", "$value": "Bitter", "$description": "Serif/slab — destaques, pequenos textos com personalidade" },
      "mono":    { "$type": "fontFamily", "$value": "monospace", "$description": "Fallback para codigo (nao e fonte de marca)" }
    },
    "fontSize": {
      "xs":   { "$type": "dimension", "$value": "12px" },
      "sm":   { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg":   { "$type": "dimension", "$value": "18px" },
      "xl":   { "$type": "dimension", "$value": "20px" },
      "2xl":  { "$type": "dimension", "$value": "24px" },
      "3xl":  { "$type": "dimension", "$value": "30px" },
      "4xl":  { "$type": "dimension", "$value": "36px" },
      "5xl":  { "$type": "dimension", "$value": "48px" },
      "6xl":  { "$type": "dimension", "$value": "64px" }
    },
    "fontWeight": {
      "regular":  { "$type": "fontWeight", "$value": 400, "$description": "Source Sans regular para corpo" },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700, "$description": "Open Sans bold para titulos" },
      "extrabold":{ "$type": "fontWeight", "$value": 800, "$description": "Open Sans extrabold para hero" }
    },
    "lineHeight": {
      "tight":   { "$type": "dimension", "$value": "1.15" },
      "normal":  { "$type": "dimension", "$value": "1.5" },
      "relaxed": { "$type": "dimension", "$value": "1.7" }
    }
  },
  "spacing": {
    "xs":  { "$type": "dimension", "$value": "4px" },
    "sm":  { "$type": "dimension", "$value": "8px" },
    "md":  { "$type": "dimension", "$value": "16px" },
    "lg":  { "$type": "dimension", "$value": "24px" },
    "xl":  { "$type": "dimension", "$value": "32px" },
    "2xl": { "$type": "dimension", "$value": "48px" },
    "3xl": { "$type": "dimension", "$value": "64px" },
    "4xl": { "$type": "dimension", "$value": "96px" }
  },
  "borderRadius": {
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "9px", "$description": "Raio dos botoes no brandbook (pagina 4)" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "9999px", "$description": "Pill — elemento decorativo canonico da marca" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(0,0,0,0.05)" },
    "md": { "$type": "shadow", "$value": "0 4px 6px rgba(0,0,0,0.07)" },
    "lg": { "$type": "shadow", "$value": "0 10px 15px rgba(0,0,0,0.1)" }
  },
  "decorativeShapes": {
    "$description": "Elementos visuais canonicos da marca (brandbook pagina 5-6). Usar em composicoes, backgrounds, bordas de hero.",
    "pill": {
      "description": "Pilula arredondada vertical ou horizontal. Pode ser preenchida ou outline. Combinavel em grupos.",
      "aspectRatios": ["1:3", "1:5", "2:1"],
      "cornerRadius": "pill (9999px)"
    },
    "arco": {
      "description": "Forma de arco (meia pilula, topo arredondado). Preenchida ou outline. Rotacionavel em 90 graus.",
      "aspectRatio": "1:1.5"
    },
    "usage": {
      "colors": ["primary", "primaryDark", "accent", "warning"],
      "rotation": "Multiplos de 90 graus",
      "composition": "Sobrepor formas em grupos de 2-5 elementos, combinando preenchido + outline"
    }
  }
}
