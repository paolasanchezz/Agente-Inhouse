<style>
  /* ----- Design Tokens (Buzzmonitor - alinhado a /social-listening-mayo-2026-latam) ----- */
  :root {
    --c-primary:   #390155;
    --c-accent:    #EB7C2E;
    --c-accent-2:  #DE2451;

    --c-n900: #14111a;
    --c-n700: #4a4658;
    --c-n500: #8a8598;
    --c-n300: #dcd9e0;
    --c-n100: #f6f4f2;
    --c-n50:  #fbf9f7;
    --c-n0:   #ffffff;

    --grad-hot: linear-gradient(120deg, #DE2451 0%, #EB7C2E 100%);

    --ff-display: "League Spartan", Georgia, serif;
    --ff-sub:     "Manrope", system-ui, sans-serif;
    --ff-body:    "Lato", "Helvetica Neue", sans-serif;

    --r-sm: 4px;
    --r-md: 12px;
    --r-lg: 22px;
    --r-pill: 9999px;

    --sh-sm:  0 1px 2px rgba(20,17,26,.05);
    --sh-md:  0 14px 38px -14px rgba(20,17,26,.18);
    --sh-cta: 0 14px 30px -10px rgba(235,124,46,.55);

    --t-quick: 180ms cubic-bezier(.2,.8,.2,1);
    --t-slow:  620ms cubic-bezier(.2,.8,.2,1);

    --max: 1180px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; overflow-x: hidden; }
  section[id], :target { scroll-margin-top: 32px; }
  body {
    margin: 0;
    background: var(--c-n0);
    color: var(--c-n900);
    font-family: var(--ff-body);
    font-size: 17px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }
  img, svg { display: block; max-width: 100%; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
  h1, h2, h3 { font-family: var(--ff-display); font-weight: 900; line-height: 1.02; letter-spacing: -0.025em; margin: 0; text-wrap: balance; }
  h2 { font-weight: 700; letter-spacing: -0.018em; }
  h3 { font-weight: 700; letter-spacing: -0.012em; }
  p  { margin: 0; }

  .wrap { width: min(100% - 48px, var(--max)); margin-inline: auto; }
  .eyebrow {
    font-family: var(--ff-sub);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
    outline: 3px solid var(--c-accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* Skip link */
  .skip {
    position: absolute; left: 12px; top: 12px;
    background: var(--c-primary); color: #fff;
    padding: 10px 16px; border-radius: 8px;
    z-index: 100; font-weight: 700;
    width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(100%);
    white-space: nowrap;
  }
  .skip:focus {
    width: auto; height: auto; overflow: visible;
    clip: auto; clip-path: none;
  }

  /* ============================================================ HEADER */
  .nav {
    position: absolute; top: 0; left: 0; right: 0; z-index: 10;
    padding: 24px 0;
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px;
  }
  .brand-mark { display: inline-flex; align-items: center; }
  .brand-mark img { height: 28px; width: auto; display: block; }
  @media (max-width: 680px) { .brand-mark img { height: 24px; } }
  .nav-meta {
    color: var(--c-n700);
    font-family: var(--ff-sub); font-size: 12px;
    letter-spacing: .16em; text-transform: uppercase;
    display: flex; align-items: center; gap: 10px;
    white-space: nowrap;
  }
  .nav-meta .dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--c-accent-2); }
  .nav-meta .dot::after {
    content: ""; position: absolute; inset: -3px;
    border-radius: 50%; background: var(--c-accent-2); opacity: .3;
    animation: pulse 2.2s ease-in-out infinite;
    transform-origin: center;
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1);   opacity: .3; }
    50%      { transform: scale(2.2); opacity: 0;  }
  }
  @media (max-width: 680px) { .nav-meta { display: none; } }

  /* ============================================================ BOTÕES */
  .btn-primary {
    display: inline-flex; align-items: center; gap: 12px;
    background: var(--c-accent);
    color: #fff;
    padding: 18px 28px;
    border-radius: var(--r-pill);
    font-family: var(--ff-sub);
    font-weight: 500;
    font-size: 16.5px;
    letter-spacing: .01em;
    box-shadow: var(--sh-cta);
    touch-action: manipulation;
    transition: transform var(--t-quick), box-shadow var(--t-quick), background var(--t-quick);
  }
  .btn-primary:hover { transform: translateY(-2px); background: var(--c-primary); box-shadow: 0 18px 36px -10px rgba(57,1,85,.5); }
  .btn-primary:active { transform: translateY(0); }
  .btn-primary .arrow { transition: transform var(--t-quick); }
  .btn-primary:hover .arrow { transform: translateX(4px); }

  /* ============================================================ HERO */
  .hero {
    position: relative;
    padding: 128px 0 96px;
    background: var(--c-n0);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 80px;
    align-items: center;
  }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; gap: 56px; } }

  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    color: var(--c-accent-2);
    margin-bottom: 28px;
  }
  .hero-eyebrow .rule { width: 48px; height: 1.5px; background: var(--c-accent-2); }

  .hero h1 {
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 1;
    letter-spacing: -0.032em;
    font-weight: 900;
    color: var(--c-n900);
    max-width: 18ch;
  }
  .hero h1 .ital { font-style: italic; font-weight: 500; color: var(--c-accent-2); }
  .hero h1 .grad {
    background: var(--grad-hot);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }

  .hero-h2 {
    margin-top: 28px;
    font-family: var(--ff-display);
    font-size:clamp(26px, 2.6vw, 34px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--c-n900);
    max-width: 28ch;
    text-wrap: balance;
  }
  .hero-h2 .ital { font-style: italic; font-weight: 500; color: var(--c-accent-2); }

  .hero-sub {
    margin-top: 24px;
    font-family: var(--ff-sub);
    font-weight: 300;
    font-size: clamp(17px, 1.5vw, 19.5px);
    color: var(--c-n700);
    max-width: 50ch;
    line-height: 1.55;
  }
  .hero-sub strong { font-weight: 500; color: var(--c-n900); }

  .hero-cta-row {
    margin-top: 40px;
    display: flex; flex-wrap: wrap; gap: 18px; align-items: center;
  }
  .hero-times {
    margin-top: 24px;
    font-family: var(--ff-sub);
    font-size: 13px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--c-n500);
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 6px 14px;
  }
  .hero-times b { color: var(--c-n900); font-weight: 700; }
  .hero-times .sep { color: var(--c-n300); }

  /* Hero right: ticket card */
  .hero-visual {
    position: relative;
    max-width: 420px;
    margin-inline: auto;
    width: 100%;
  }
  @media (min-width: 961px) { .hero-visual { margin-inline: auto 0; } }
  .ticket {
    position: relative;
    background: #fff;
    border-radius: var(--r-lg);
    padding: 36px 34px 32px;
    font-family: var(--ff-sub);
    border: 1px solid var(--c-n300);
    box-shadow: 0 30px 60px -30px rgba(57,1,85,.18), 0 8px 20px -12px rgba(20,17,26,.1);
    overflow: hidden;
    transition: transform .4s ease, border-color .4s ease;
    transform-style: preserve-3d;
  }
  .ticket:hover {
    transform: perspective(800px) rotateX(8deg) rotateY(-8deg) translateZ(10px);
    border-color: #EF863C;
  }
  @media (prefers-reduced-motion: reduce) { .ticket:hover { transform: none; } }
  .ticket::before {
    content: ""; position: absolute;
    top: 0; left: 0; right: 0; height: 5px;
    background: var(--grad-hot);
  }
  .ticket-label {
    font-size: 11px; letter-spacing: .28em; text-transform: uppercase;
    color: var(--c-accent-2); font-weight: 500;
  }
  .ticket-date {
    margin-top: 12px;
    font-family: var(--ff-display); font-weight: 900;
    font-size: clamp(52px, 5.4vw, 72px);
    line-height: .95; letter-spacing: -0.03em;
    color: var(--c-n900);
  }
  .ticket-date .slash { color: var(--c-accent); }
  .ticket-date small { display: block; font-family: var(--ff-sub); font-weight: 400; font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--c-n500); margin-top: 10px; }
  .ticket-rows { margin-top: 24px; border-top: 1px dashed var(--c-n300); padding-top: 20px; display: grid; gap: 14px; font-size: 14px; }
  .ticket-rows > div { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .ticket-rows dt { color: var(--c-n500); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; margin: 0; }
  .ticket-rows dd { margin: 0; font-weight: 500; color: var(--c-n900); text-align: right; }

  .hero-visual::before,
  .hero-visual::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    z-index: -1;
  }
  .hero-visual::before {
    width: 170px; height: 170px;
    border: 1.5px solid var(--c-n300);
    left: -60px; top: -40px;
  }
  .hero-visual::after {
    width: 90px; height: 90px;
    background: var(--grad-hot);
    right: -30px; bottom: -30px;
    filter: blur(30px);
    opacity: .35;
  }

  /* ============================================================ SEÇÕES (defaults) */
  section { padding: 128px 0; position: relative; }
  @media (max-width: 720px) { section { padding: 80px 0; } }

  .sec-head { display: grid; gap: 16px; margin-bottom: 58px; max-width: 880px; }
  .sec-head .eyebrow { color: var(--c-accent-2); }
  .sec-head h2 { font-size:clamp(34px, 4.2vw, 54px); color: var(--c-n900); }
  .sec-head .center { text-align: center; margin-inline: auto; }

  /* ============================================================ SPEAKER + FORM */
  .speaker-form { background: var(--c-n100); }
  .sf-head { text-align: center; max-width: 760px; margin: 0 auto 56px; }
  .sf-head .eyebrow { color: var(--c-accent-2); }
  .sf-head h2 { font-size:clamp(34px, 3.8vw, 46px); color: var(--c-n900); margin-top: 14px; }
  .sf-head .sub { margin-top: 18px; font-family: var(--ff-sub); font-weight: 400; color: var(--c-n700); font-size: 17px; }

  .sf-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 36px;
    align-items: stretch;
  }
  @media (max-width: 900px) { .sf-grid { grid-template-columns: 1fr; gap: 24px; } }

  .speaker-card {
    background: #fff;
    border: 1px solid var(--c-n300);
    border-radius: var(--r-lg);
    padding: 48px 36px;
    display: flex; flex-direction: column; align-items: center; gap: 16px;
    text-align: center;
    box-shadow: var(--sh-sm);
    transition: transform var(--t-quick), box-shadow var(--t-quick), border-color var(--t-quick);
  }
  .speaker-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-md);
    border-color: var(--c-accent);
  }
  .sp-photo {
    width: 168px; height: 168px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--c-n100);
    display: grid; place-items: center;
    color: var(--c-n500);
    border: 1px solid var(--c-n300);
    box-shadow: 0 8px 24px rgba(57,1,85,.08);
  }
  /* min-height:0 e obrigatorio: <img> intrinseco como grid item estoura no
     Safari iOS sem isso (GUIDELINES 14). */
  .sp-photo .sp-img { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 0; }
  .sp-photo .sp-initials {
    font-family: var(--ff-display);
    font-size: 54px; font-weight: 900; line-height: 1;
    background: var(--grad-hot);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .sp-photo .sp-photo-text {
    font-family: var(--ff-sub);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--c-n500);
    text-align: center;
    padding: 0 10px;
  }
  .sp-name {
    font-family: var(--ff-display); font-weight: 900;
    font-size:clamp(22px, 2.2vw, 26px);
    color: var(--c-n900); line-height: 1.15; margin: 4px 0 0;
    letter-spacing: -0.015em;
  }
  .sp-role {
    font-family: var(--ff-sub); font-weight: 400;
    font-size: 14.5px; color: var(--c-n700); margin: 0;
  }
  .sp-bio {
    font-family: var(--ff-sub); font-weight: 300;
    font-size: 14.5px; color: var(--c-n700); margin: 8px 0 0;
    max-width: 36ch; line-height: 1.55;
  }

  .form-card {
    background: #fff; border-radius: var(--r-lg);
    padding: 40px 36px; border: 1px solid var(--c-n300);
    box-shadow: var(--sh-md);
  }
  .form-card h3 { font-family: var(--ff-display); font-size: 24px; color: var(--c-n900); margin-bottom: 6px; letter-spacing: -0.012em; }
  .form-card .form-sub { font-family: var(--ff-sub); font-weight: 400; font-size: 14.5px; color: var(--c-n700); margin: 0 0 24px; }
  .field { display: grid; gap: 6px; margin-bottom: 18px; }
  .field label { font-family: var(--ff-sub); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--c-n700); font-weight: 500; transition: color var(--t-quick); }
  .field input {
    font: inherit;
    padding: 14px 16px;
    border-radius: var(--r-md);
    border: 1.5px solid var(--c-n300);
    background: var(--c-n0);
    color: var(--c-n900);
    transition: border-color var(--t-quick), box-shadow var(--t-quick), background var(--t-quick);
    width: 100%;
  }
  .field input:hover { border-color: var(--c-accent-2); }
  .field input:focus { border-color: var(--c-accent); outline: 3px solid rgba(235,124,46,.22); outline-offset: 0; background: #fffaf5; }
  .field:focus-within label { color: var(--c-accent-2); }
  .form-status {
    font-family: var(--ff-sub); font-size: 14px; font-weight: 500;
    margin: 14px 0 0; min-height: 1.2em;
  }
  .form-status[data-tipo="erro"] { color: var(--c-accent-2); }
  .form-status[data-tipo="ok"]   { color: var(--c-primary); }
  .form-card.enviado .form-ok { display: block; }
  .form-card button[type="submit"] {
    width: 100%;
    background: var(--c-accent);
    color: #fff;
    padding: 18px 20px;
    border-radius: var(--r-md);
    font-family: var(--ff-sub); font-weight: 500; font-size: 17px;
    letter-spacing: .02em;
    touch-action: manipulation;
    transition: background var(--t-quick), transform var(--t-quick), box-shadow var(--t-quick);
    margin-top: 8px;
    box-shadow: 0 10px 26px -12px rgba(235,124,46,.5);
  }
  .form-card button[type="submit"]:hover { background: var(--c-primary); transform: translateY(-2px); box-shadow: 0 18px 36px -10px rgba(57,1,85,.4); }
  .form-card .disclaimer { font-size: 12.5px; color: var(--c-n500); margin-top: 14px; line-height: 1.55; font-family: var(--ff-sub); }

  /* ============================================================ LOGOS WALL - slider + KPI overlays */
  .logos-wall { background: var(--c-n0); }
  .lw-head { text-align: center; max-width: 880px; margin: 0 auto 56px; }
  .lw-head .eyebrow { color: var(--c-accent-2); }
  .lw-head h2 { font-size:clamp(34px, 4vw, 50px); color: var(--c-n900); margin-top: 14px; }

  .mural-stage {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: 30px 80px;
  }
  .mural-frame {
    position: relative;
    max-width: 940px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: #fff;
    border: 1px solid var(--c-n300);
    box-shadow: var(--sh-md);
  }
  .mural-track {
    display: flex;
    width: 200%;
    animation: mural-slide 16s ease-in-out infinite;
  }
  .mural-track .logos-img {
    width: 50%;
    flex-shrink: 0;
    display: block;
    margin: 0;
    padding: 24px;
    background: white;
    box-sizing: border-box;
  }
  @keyframes mural-slide {
    0%, 45%   { transform: translateX(0); }
    50%, 95%  { transform: translateX(-50%); }
    100%      { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mural-track { animation: none; }
  }
  .mural-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
  }
  .mural-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--c-n300);
    animation: dot-cycle 16s ease-in-out infinite;
  }
  .mural-dot:nth-child(2) { animation-delay: 8s; }
  @keyframes dot-cycle {
    0%, 45%   { background: var(--c-accent); transform: scale(1.25); }
    50%, 100% { background: var(--c-n300); transform: scale(1); }
  }

  .kpi-overlay {
    position: absolute;
    background: #fff;
    border-radius: var(--r-lg);
    padding: 16px 22px;
    border: 1px solid var(--c-n300);
    box-shadow: var(--sh-md);
    text-align: center;
    z-index: 2;
    min-width: 130px;
  }
  .kpi-overlay-number {
    display: block;
    font-family: var(--ff-display);
    font-weight: 900;
    font-size: 32px;
    background: var(--grad-hot);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
    line-height: 1;
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }
  .kpi-overlay-label {
    display: block;
    font-family: var(--ff-sub);
    font-weight: 400;
    font-size: 12.5px;
    color: var(--c-n700);
    line-height: 1.35;
  }
  .kpi-overlay-tl { top: 0;    left: 0; }
  .kpi-overlay-tr { top: 0;    right: 0; }
  .kpi-overlay-bl { bottom: 0; left: 0; }
  .kpi-overlay-br { bottom: 0; right: 0; }

  /* ============================================================ TESTIMONIALS - orgânico, fundo pêssego */
  .testimonials { background: #FFF4E8; padding: 110px 0 130px; }
  .testimonials-header { text-align: center; max-width: 920px; margin: 0 auto 64px; }
  .testimonials-header .eyebrow { color: var(--c-accent-2); }
  .testimonials-h2 {
    font-family: var(--ff-display);
    font-weight: 800;
    font-size:clamp(34px, 4vw, 50px);
    line-height: 1.1;
    color: var(--c-n900);
    margin: 14px 0 0;
    letter-spacing: -0.02em;
  }
  .testimonials-grid {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    min-height: 740px;
  }
  .testimonial-card {
    background: #fff;
    border: 1px solid var(--c-n300);
    border-left: 4px solid var(--c-accent-2);
    border-radius: var(--r-lg);
    padding: 24px 26px;
    display: flex; flex-direction: column; gap: 14px;
    box-shadow: var(--sh-sm);
    position: absolute;
    transition: transform var(--t-quick), box-shadow var(--t-quick), border-color var(--t-quick);
  }
  .testimonial-card:hover {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: var(--sh-md);
    border-left-color: var(--c-accent);
    z-index: 10;
  }
  .testimonial-stars {
    display: inline-flex;
    gap: 4px;
    color: var(--c-accent);
  }
  .testimonial-stars svg { width: 18px; height: 18px; display: block; }
  .testimonial-quote {
    font-family: var(--ff-body);
    font-weight: 400;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--c-n900);
    margin: 0;
  }
  .testimonial-meta {
    font-family: var(--ff-sub);
    font-size: 13px;
    color: var(--c-n700);
    margin: 0;
  }
  .testimonial-author { font-family: var(--ff-display); font-weight: 700; color: var(--c-n900); letter-spacing: -0.005em; font-size: 14px; }
  .testimonial-company { color: var(--c-n500); }

  .testimonial-card:nth-child(1) { left: 2%;  top: 0px;   width: 32%; transform: rotate(-1.4deg); z-index: 2; }
  .testimonial-card:nth-child(2) { left: 36%; top: 56px;  width: 48%; transform: rotate(0.9deg);  z-index: 3; }
  .testimonial-card:nth-child(3) { left: 4%;  top: 220px; width: 52%; transform: rotate(-0.7deg); z-index: 4; }
  .testimonial-card:nth-child(4) { left: 60%; top: 304px; width: 36%; transform: rotate(1.7deg);  z-index: 3; }
  .testimonial-card:nth-child(5) { left: 1%;  top: 460px; width: 33%; transform: rotate(-1.8deg); z-index: 3; }
  .testimonial-card:nth-child(6) { left: 36%; top: 504px; width: 58%; transform: rotate(0.5deg);  z-index: 4; }

  /* ============================================================ URGÊNCIA (dark) */
  .urgency {
    background: var(--c-primary);
    color: #fff;
    overflow: hidden;
    position: relative;
    padding: 144px 0;
  }
  .urgency::before {
    content: ""; position: absolute;
    width: 520px; height: 520px; border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,.1);
    top: -260px; right: -120px;
    pointer-events: none;
  }
  .urgency::after {
    content: ""; position: absolute;
    width: 340px; height: 340px; border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,.07);
    top: -180px; right: 180px;
    pointer-events: none;
  }
  .urgency-inner { position: relative; max-width: 820px; }
  .urgency .eyebrow { color: var(--c-accent); }
  .urgency h2 {
    margin-top: 22px;
    font-size: clamp(38px, 5.6vw, 78px);
    max-width: 22ch;
    color: #fff;
    line-height: 1.05;
  }
  .urgency h2 em { font-style: italic; font-weight: 500; }
  .urgency .tag {
    display: inline-block;
    padding: 0 .42em .08em;
    background: var(--grad-hot);
    color: #fff;
    font-weight: 900; font-style: italic;
    border-radius: 14px;
    box-shadow: 0 10px 24px -10px rgba(222,36,81,.55);
    transform: rotate(-2deg);
    transform-origin: left center;
  }
  .urgency .question {
    margin-top: 32px;
    font-family: var(--ff-sub); font-style: italic; font-weight: 400;
    font-size: clamp(18px, 1.9vw, 22px);
    color: rgba(255,255,255,.85);
    max-width: 50ch;
  }
  .urgency-cta { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; }
  .urgency-meta { font-family: var(--ff-sub); font-size: 14px; color: rgba(255,255,255,.7); letter-spacing: .14em; text-transform: uppercase; }
  .urgency-meta b { color: #fff; font-weight: 700; }

  /* ============================================================ FOOTER */
  footer {
    background: var(--c-n900); color: rgba(255,255,255,.75);
    padding: 70px 0 34px;
    font-family: var(--ff-sub); font-size: 14px;
  }
  footer .f-grid { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 24px; align-items: center; }
  footer .f-brand { font-family: var(--ff-display); font-weight: 900; color: #fff; font-size: 22px; letter-spacing: -0.01em; }
  footer .f-links { display: flex; flex-wrap: wrap; gap: 22px 26px; align-items: center; }
  footer .f-link { font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: rgba(255,255,255,.6); transition: color 180ms ease; }
  footer .f-link:hover, footer .f-link:focus-visible { color: var(--c-accent); }
  footer .legal { font-size: 12px; color: rgba(255,255,255,.5); margin-top: 32px; border-top: 1px solid rgba(255,255,255,.12); padding-top: 22px; line-height: 1.7; }

  /* ============================================================ REVEAL */
  @media (prefers-reduced-motion: no-preference) {
    .js .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity var(--t-slow), transform var(--t-slow);
      transition-delay: var(--d, 0ms);
    }
    .js .reveal.in { opacity: 1; transform: none; }
  }

  /* ============================================================ RESPONSIVE OVERRIDES */
  @media (max-width: 960px) {
    .hero { padding: 110px 0 64px; }
    .hero h1 { max-width: none; }

    .speaker-card { padding: 36px 24px; }
    .form-card { padding: 32px 26px; }

    .mural-stage {
      padding: 0;
      display: grid;
      grid-template-areas:
        "mural mural"
        "tl tr"
        "bl br";
      gap: 14px;
    }
    .mural-frame { grid-area: mural; }
    .kpi-overlay {
      position: static;
      max-width: none;
      padding: 14px 18px;
      border-radius: var(--r-md);
      text-align: left;
      min-width: 0;
    }
    .kpi-overlay-tl { grid-area: tl; }
    .kpi-overlay-tr { grid-area: tr; }
    .kpi-overlay-bl { grid-area: bl; }
    .kpi-overlay-br { grid-area: br; }
    .kpi-overlay-number { font-size: 26px; }

    .testimonials-grid {
      min-height: auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .testimonial-card,
    .testimonial-card:nth-child(n) {
      position: static;
      left: auto; top: auto; right: auto; bottom: auto;
      width: 100%;
      transform: none;
    }
    .testimonial-card:hover { transform: none; }

    .urgency { padding: 96px 0; }
  }

  @media (max-width: 540px) {
    .ticket { padding: 28px 26px 26px; }
    .sp-photo { width: 140px; height: 140px; }
    .hero-times { font-size: 12px; }
  }

  /* ===== GUIDELINES 20 - pisos de tipografia mobile ===== */
  @media (max-width:640px){
  .eyebrow{ font-size:14px; }
  .btn-primary{ font-size:17px; }
  .ticket-label{ font-size:12px; }
  .ticket-date small{ font-size:14px; }
  .ticket-rows{ font-size:15px; }
  .ticket-rows dt{ font-size:12px; }
  .sp-photo .sp-photo-text{ font-size:12px; }
  .sp-role{ font-size:15px; }
  .sp-bio{ font-size:15px; }
  .form-card .form-sub{ font-size:15px; }
  .field label{ font-size:13px; }
  .form-card .disclaimer{ font-size:13px; }
  .kpi-overlay-label{ font-size:13px; }
  .testimonial-quote{ font-size:15px; }
  .testimonial-meta{ font-size:14px; }
  .testimonial-author{ font-size:15px; }
  .urgency-meta{ font-size:15px; }
  footer{ font-size:15px; }
  footer .f-link{ font-size:13px; }
  footer .legal{ font-size:13px; }
  }
</style>
