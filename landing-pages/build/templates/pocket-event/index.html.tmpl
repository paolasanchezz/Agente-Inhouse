<script>
  // Reveals - fallback se IntersectionObserver não existir
  (function () {
    var reveals = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) {
      reveals.forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(function (el) { obs.observe(el); });

    // Fallback: força visível depois de 1.5s caso algo trave
    window.setTimeout(function () {
      document.querySelectorAll('.reveal:not(.in)').forEach(function (el) {
        var rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight) el.classList.add('in');
      });
    }, 1500);
  })();
</script>

<script>
  /* Inscricao do Pocket Event -> Apps Script -> planilha unica de inscricoes.
     Grava url_conversao e UTMs: lead sem os dois some do filtro das dashboards
     de CM (CONTEXT 5.5). text/plain evita o preflight CORS, que o Apps Script
     nao responde (mesmo padrao de bant-america-digital-2026). */
  (function () {
    var ENDPOINT = '{{FORM_ENDPOINT}}';
    var form = document.getElementById('pocket-form');
    if (!form) return;
    var botao = form.querySelector('button[type="submit"]');
    var estado = document.getElementById('form-status');

    function avisar(texto, tipo) {
      estado.textContent = texto;
      estado.setAttribute('data-tipo', tipo || 'ok');
    }
    function utm(nome) {
      try { return new URLSearchParams(window.location.search).get(nome) || ''; }
      catch (e) { return ''; }
    }
    function coletar() {
      return {
        edicao: '{{SLUG}}',
        evento: '{{TITULO_TEXTO}}',
        data_evento: '{{DATA_ISO}}',
        horario: '{{HORARIO_TEXTO}}',
        speaker: '{{SPEAKER_NOME_TEXTO}}',
        nome: form.querySelector('#f-nome').value.trim(),
        email: form.querySelector('#f-email').value.trim().toLowerCase(),
        empresa: form.querySelector('#f-empresa').value.trim(),
        cargo: form.querySelector('#f-cargo').value.trim(),
        url_conversao: window.location.href.split('#')[0],
        utm_source: utm('utm_source'),
        utm_medium: utm('utm_medium'),
        utm_campaign: utm('utm_campaign'),
        utm_content: utm('utm_content')
      };
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      avisar('');
      if (!form.checkValidity()) { form.reportValidity(); return; }

      var dados = coletar();
      botao.disabled = true;
      avisar('Enviando...');

      fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(dados)
      })
        .then(function (r) { return r.json(); })
        .then(function (r) {
          if (!r || !r.ok) throw new Error(r && r.error ? r.error : 'Resposta invalida');
          form.reset();
          avisar(r.duplicado
            ? 'Você já estava inscrito. Até lá!'
            : 'Vaga confirmada. Você recebe os detalhes por e-mail.');
          if (window.dataLayer) {
            window.dataLayer.push({ event: 'pocket_event_inscricao', edicao: dados.edicao });
          }
        })
        .catch(function (err) {
          console.error('Falha no envio:', err);
          avisar('Não foi possível enviar. Confira a conexão e tente de novo.', 'erro');
        })
        .then(function () { botao.disabled = false; });
    });
  })();
</script>

