# ============================================================
# Meta Ads — Configuração de Ambiente
# Copie este arquivo para .env na raiz do projeto e preencha.
# NUNCA commitar o .env real.
# ============================================================

# Token de acesso de longa duração (validade: ~60 dias)
# Para gerar: Business Manager > Configurações > Tokens de acesso
# Permissão necessária: ads_read APENAS (somente leitura)
META_ACCESS_TOKEN=

# Data de criação do token (formato YYYY-MM-DD)
# Usada para alertar quando faltarem 10 dias para expirar
META_TOKEN_CREATED_AT=

# Versão da API Meta Marketing
META_API_VERSION=v21.0

# ============================================================
# IDs das contas — formato: act_XXXXXXXXX
# ============================================================

# Buzzmonitor
META_ACCOUNT_BUZZMONITOR_BRL=
META_ACCOUNT_BUZZMONITOR_USD=
META_ACCOUNT_BUZZMONITOR_EUR=

# Cxpress
META_ACCOUNT_CXPRESS_BRL=
META_ACCOUNT_CXPRESS_USD=
META_ACCOUNT_CXPRESS_EUR=

# Adicione aqui se Buzzcreators ou Elife também tiverem contas Meta Ads:
# META_ACCOUNT_BUZZCREATORS_BRL=
# META_ACCOUNT_ELIFE_BRL=
